# Kafka Connect Configuration
CONNECT_BOOTSTRAP_SERVERS=kafka:29092
CONNECT_REST_ADVERTISED_HOST_NAME=kafka-connect
CONNECT_REST_PORT=8083
CONNECT_GROUP_ID=compose-connect-group

# Topic Configuration
CONNECT_CONFIG_STORAGE_TOPIC=docker-connect-configs
CONNECT_CONFIG_STORAGE_REPLICATION_FACTOR=1
CONNECT_OFFSET_STORAGE_TOPIC=docker-connect-offsets
CONNECT_OFFSET_STORAGE_REPLICATION_FACTOR=1
CONNECT_STATUS_STORAGE_TOPIC=docker-connect-status
CONNECT_STATUS_STORAGE_REPLICATION_FACTOR=1

# Converter Configuration
CONNECT_KEY_CONVERTER=org.apache.kafka.connect.storage.StringConverter
CONNECT_VALUE_CONVERTER=io.confluent.connect.avro.AvroConverter
CONNECT_VALUE_CONVERTER_SCHEMA_REGISTRY_URL=http://schema-registry:8081
CONNECT_INTERNAL_KEY_CONVERTER=org.apache.kafka.connect.json.JsonConverter
CONNECT_INTERNAL_VALUE_CONVERTER=org.apache.kafka.connect.json.JsonConverter

# Plugin Configuration
CONNECT_PLUGIN_PATH=/usr/share/java,/usr/share/confluent-hub-components,/etc/kafka-connect/jars

# Performance Settings
CONNECT_OFFSET_FLUSH_INTERVAL_MS=10000
CONNECT_OFFSET_FLUSH_TIMEOUT_MS=5000
CONNECT_TASK_SHUTDOWN_GRACEFUL_TIMEOUT_MS=30000
CONNECT_PRODUCER_COMPRESSION_TYPE=snappy
CONNECT_CONSUMER_SESSION_TIMEOUT_MS=30000

# Worker Configuration
CONNECT_CLIENT_ID=kafka-connect-worker
CONNECT_HEARTBEAT_INTERVAL_MS=3000
CONNECT_SESSION_TIMEOUT_MS=30000
CONNECT_REBALANCE_TIMEOUT_MS=60000

# Security Configuration (for development)
CONNECT_SECURITY_PROTOCOL=PLAINTEXT
CONNECT_SASL_MECHANISM=PLAIN

# Logging Configuration
CONNECT_LOG4J_LOGGERS=org.apache.zookeeper=ERROR,org.I0Itec.zkclient=ERROR,org.reflections=ERROR
CONNECT_LOG4J_ROOT_LOGLEVEL=INFO

# Database Connection Configuration for CDC
# PostgreSQL Source Database
POSTGRES_SOURCE_HOST=postgres-source
POSTGRES_SOURCE_PORT=5432
POSTGRES_SOURCE_DATABASE=source_db
POSTGRES_SOURCE_USERNAME=source_user
POSTGRES_SOURCE_PASSWORD=source_password

# PostgreSQL Sink Database
POSTGRES_SINK_HOST=postgres-sink
POSTGRES_SINK_PORT=5432
POSTGRES_SINK_DATABASE=sink_db
POSTGRES_SINK_USERNAME=sink_user
POSTGRES_SINK_PASSWORD=sink_password

# Debezium Specific Settings
DEBEZIUM_SLOT_NAME=debezium_slot
DEBEZIUM_PUBLICATION_NAME=dbz_publication 