# PostgreSQL Source Database Configuration
POSTGRES_DB=source_db
POSTGRES_USER=source_user
POSTGRES_PASSWORD=source_password
# Using default PostgreSQL authentication (md5/scram-sha-256)

# Database connection settings
POSTGRES_HOST=postgres-source
POSTGRES_PORT=5432

# Performance settings
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB

# Logging settings
POSTGRES_LOG_STATEMENT=all
POSTGRES_LOG_MIN_DURATION_STATEMENT=1000

# Replication settings (for Debezium CDC)
POSTGRES_WAL_LEVEL=logical
POSTGRES_MAX_WAL_SENDERS=3
POSTGRES_MAX_REPLICATION_SLOTS=3 