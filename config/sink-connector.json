{
  "name": "postgres-sink-connector",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "tasks.max": "3",
    "connection.url": "jdbc:postgresql://postgres-sink:5432/sink_db",
    "connection.user": "sink_user",
    "connection.password": "sink_password",
    "topics": "postgres-source-customers,postgres-source-products,postgres-source-orders",
    "auto.create": "true",
    "auto.evolve": "true",
    "insert.mode": "insert",
    "table.name.format": "staging.raw_${topic}",
    "batch.size": 100,
    "max.retries": 10,
    "retry.backoff.ms": 3000,
    "db.timezone": "UTC",
    "transforms": "dropPrefix",
    "transforms.dropPrefix.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.dropPrefix.regex": "postgres-source-(.*)",
    "transforms.dropPrefix.replacement": "$1"
  }
} 