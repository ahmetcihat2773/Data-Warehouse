# PostgreSQL Sink Database Configuration
POSTGRES_DB=sinkdb
POSTGRES_USER=sinkuser
POSTGRES_PASSWORD=sinkpass
# Using default PostgreSQL authentication (md5)

# Database connection settings
POSTGRES_HOST=postgres-sink
POSTGRES_PORT=5432

# Performance settings
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB

# Logging settings
POSTGRES_LOG_STATEMENT=all
POSTGRES_LOG_MIN_DURATION_STATEMENT=1000

# Sink specific settings (no replication needed)
POSTGRES_WAL_LEVEL=replica
POSTGRES_ARCHIVE_MODE=off 

