# Schema Registry Configuration
SCHEMA_REGISTRY_HOST_NAME=dwh-schema-registry
SCHEMA_REGISTRY_KAFKASTORE_BOOTSTRAP_SERVERS=dwh-kafka:29092
SCHEMA_REGISTRY_LISTENERS=http://0.0.0.0:8081
SCHEMA_REGISTRY_DEBUG=false

# Kafka Store Configuration
SCHEMA_REGISTRY_KAFKASTORE_TOPIC=_schemas
SCHEMA_REGISTRY_KAFKASTORE_TOPIC_REPLICATION_FACTOR=1
SCHEMA_REGISTRY_KAFKASTORE_TIMEOUT_MS=500
SCHEMA_REGISTRY_KAFKASTORE_INIT_TIMEOUT_MS=60000

# Schema Registry Group and Leadership
SCHEMA_REGISTRY_SCHEMA_REGISTRY_GROUP_ID=schema-registry
SCHEMA_REGISTRY_MASTER_ELIGIBILITY=true
SCHEMA_REGISTRY_LEADER_ELIGIBILITY=true

# Performance and JVM Settings
SCHEMA_REGISTRY_HEAP_OPTS=-Xms512M -Xmx512M
SCHEMA_REGISTRY_JVM_PERFORMANCE_OPTS=-server -XX:+UseG1GC -XX:MaxGCPauseMillis=20 -XX:+ExplicitGCInvokesConcurrent -XX:+UseStringDeduplication

# API Configuration
SCHEMA_REGISTRY_ACCESS_CONTROL_ALLOW_ORIGIN=*
SCHEMA_REGISTRY_ACCESS_CONTROL_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,HEAD
SCHEMA_REGISTRY_ACCESS_CONTROL_ALLOW_HEADERS=origin,content-type,accept,authorization,x-requested-with

# Security Configuration (Development Mode)
SCHEMA_REGISTRY_AUTHENTICATION_METHOD=NONE
SCHEMA_REGISTRY_AUTHORIZATION_METHOD=NONE
SCHEMA_REGISTRY_SSL_KEYSTORE_LOCATION=
SCHEMA_REGISTRY_SSL_KEYSTORE_PASSWORD=
SCHEMA_REGISTRY_SSL_TRUSTSTORE_LOCATION=
SCHEMA_REGISTRY_SSL_TRUSTSTORE_PASSWORD=

# Schema Compatibility and Evolution
SCHEMA_REGISTRY_SCHEMA_COMPATIBILITY_LEVEL=BACKWARD
SCHEMA_REGISTRY_SCHEMA_PROVIDERS=io.confluent.kafka.schemaregistry.avro.AvroSchemaProvider,io.confluent.kafka.schemaregistry.json.JsonSchemaProvider,io.confluent.kafka.schemaregistry.protobuf.ProtobufSchemaProvider

# Response and Request Settings
SCHEMA_REGISTRY_RESPONSE_MEDIATYPE_PREFERRED=application/vnd.schemaregistry.v1+json,application/vnd.schemaregistry+json,application/json
SCHEMA_REGISTRY_REQUEST_LOGGER_NAME=io.confluent.rest-utils.requests

# Logging Configuration
SCHEMA_REGISTRY_LOG4J_ROOT_LOGLEVEL=INFO
SCHEMA_REGISTRY_LOG4J_LOGGERS=kafka.authorizer.logger=INFO,org.apache.kafka=WARN,org.eclipse.jetty=WARN

# Metrics and Monitoring
SCHEMA_REGISTRY_ENABLE_METRICS=true
SCHEMA_REGISTRY_METRICS_SAMPLE_WINDOW_MS=30000
SCHEMA_REGISTRY_METRICS_NUM_SAMPLES=2

# Cache Settings
SCHEMA_REGISTRY_SCHEMA_CACHE_SIZE=1000
SCHEMA_REGISTRY_SCHEMA_CACHE_EXPIRY_SECS=300

# Inter-Instance Communication
SCHEMA_REGISTRY_INTER_INSTANCE_PROTOCOL=http
SCHEMA_REGISTRY_INTER_INSTANCE_LISTENER=http://0.0.0.0:8081

# Data Warehouse Project Specific
PROJECT_NAME=data-warehouse
ENVIRONMENT=development 